{
    // Groups: 1-2 are the heap memcheck builds with HeapStress, 3-4 the Wire Protocol debugger builds (deployment
    // over TCP, simulated flash), 5 the GC/compaction bench. Each name ends with the preset it runs in [brackets];
    // the preLaunchTask builds that preset first. See targets/posix/doc/README.md and targets/posix/doc/HANDOFF.md.
    "version": "0.2.0",
    "inputs": [
        {
            "id": "gcStress",
            "type": "pickString",
            "description": "NANOCLR_GC_STRESS: full GC before every n-th allocation (0 = off; 1 is the natural choice natively)",
            "options": [
                "0",
                "1",
                "20",
                "50",
                "100"
            ],
            "default": "1"
        },
        {
            "id": "compactStress",
            "type": "pickString",
            "description": "NANOCLR_COMPACT_STRESS: compaction after every n-th stress GC (0 = off, needs GC stress)",
            "options": [
                "0",
                "1",
                "5"
            ],
            "default": "0"
        },
        {
            "id": "quarantine",
            "type": "pickString",
            "description": "NANOCLR_HEAP_QUARANTINE: keep objects freed by a GC inaccessible until the next one",
            "options": [
                "0",
                "1"
            ],
            "default": "0"
        },
        {
            "id": "heapMb",
            "type": "pickString",
            "description": "NANOCLR_HEAP_SIZE_MB: managed heap size (10 is the host default, 32 matches NXP_MIMXRT1060_EVK; quarantine needs more)",
            "options": [
                "8",
                "10",
                "16",
                "32",
                "64",
                "128"
            ],
            "default": "10"
        },
        {
            "id": "networkPort",
            "type": "promptString",
            "description": "TCP port for the Wire Protocol debugger",
            "default": "26000"
        },
        {
            "id": "announceHost",
            "type": "promptString",
            "description": "Address announced to debuggers: 127.0.0.1 for a client beside the CLR, the container address for one in another container",
            "default": "127.0.0.1"
        },
        {
            "id": "flashImage",
            "type": "promptString",
            "description": "File the simulated flash is kept in, so a deployment survives a restart of the process. Keep it outside build/; .devcontainer/POSIX/flash-clean.sh blanks it.",
            "default": "/home/nano/nanoclr-flash.img"
        },
        {
            "id": "wpTrace",
            "type": "pickString",
            "description": "Hex dump every Wire Protocol packet. Leave at 0 for any timing run - it costs a printf and a flush per packet.",
            "options": [
                "0",
                "1"
            ],
            "default": "0"
        }
    ],
    "configurations": [
        // Runs HeapStress under gdb; with GC stress a CLR bug is a crash and gdb stops there.
        // Preset: posix-x64-memcheck (targets/posix/CMakePresets.json)
        {
            "name": "HeapStress x64 - native",
            "presentation": {
                "group": "1 x64 (posix-x64-memcheck)",
                "order": 1
            },
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "prepare: x64 memcheck + HeapStress",
            "program": "${workspaceFolder}/build/posix64-memcheck/bin/nanoFramework.nanoCLR.test",
            "args": [
                "build/heapstress/refs",
                "build/heapstress/HeapStress.pe"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "NANOCLR_GC_STRESS",
                    "value": "${input:gcStress}"
                },
                {
                    "name": "NANOCLR_COMPACT_STRESS",
                    "value": "${input:compactStress}"
                },
                {
                    "name": "NANOCLR_HEAP_QUARANTINE",
                    "value": "${input:quarantine}"
                },
                {
                    "name": "NANOCLR_HEAP_SIZE_MB",
                    "value": "${input:heapMb}"
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "CLR symbols live in the shared library, which loads after start",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                }
            ]
        },
        // Runs HeapStress under valgrind; gdb attaches through vgdb and stops at every memcheck report.
        // Preset: posix-x64-memcheck (targets/posix/CMakePresets.json)
        {
            "name": "HeapStress x64 - valgrind + gdb",
            "presentation": {
                "group": "1 x64 (posix-x64-memcheck)",
                "order": 2
            },
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "valgrind: HeapStress x64 (vgdb)",
            "program": "${workspaceFolder}/build/posix64-memcheck/bin/nanoFramework.nanoCLR.test",
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "targetArchitecture": "x64",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "CLR symbols live in the shared library, which loads after start",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                }
            ],
            "customLaunchSetupCommands": [
                {
                    "description": "Attach to the valgrind started by the preLaunchTask (program, arguments and environment are set there)",
                    "text": "target remote | /usr/bin/vgdb --vgdb-prefix=/tmp/vgdb-heapstress-x64",
                    "ignoreFailures": false
                }
            ],
            "launchCompleteCommand": "exec-continue"
        },
        // As the x64 variant, on the i386 build with the 12-byte heap block.
        // Preset: posix-x86-memcheck (targets/posix/CMakePresets.json)
